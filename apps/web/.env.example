# Copy to .env.local and fill in the values printed by `pnpm db:start`.
# On Vercel, set these per environment: Preview (PRs + main → staging) and Production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (never NEXT_PUBLIC_). Lets the server sync Strava without a signed-in user.
# Local value: `supabase status` → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Strava (https://www.strava.com/settings/api). Leave blank until the Strava app exists;
# the Devices page then shows "coming soon". See docs/integrations/strava.md.
APP_URL=http://localhost:3000
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
